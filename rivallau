--// ---------- Movement Recorder (ported feature; native RIVALS UI style) ----------
do
    local M = CFG.movement
    local Recorder = {
        recording = false,
        playing = false,
        samples = {},
        playbackIndex = 1,
        elapsed = 0,
        sampleClock = 0,
        replayClock = 0,
        folder = "Rivals/recordings",
        activeName = "route_1",
        status = "idle",
    }

    local function recorderNotify(message)
        local notify = getgenv().riv_notify
        if type(notify) == "function" then
            pcall(notify, "Recorder: " .. tostring(message), 3)
        end
    end

    local function recorderCharacter()
        local character = LocalPlayer.Character
        if not character then return nil end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return nil end
        return character, root, humanoid
    end

    local function ensureRecorderFolder()
        pcall(function()
            if makefolder and isfolder and not isfolder("Rivals") then makefolder("Rivals") end
            if makefolder and isfolder and not isfolder(Recorder.folder) then makefolder(Recorder.folder) end
        end)
    end

    local function validRecordingName(name)
        name = tostring(name or ""):gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
        if #name > 48 then name = name:sub(1, 48) end
        return name
    end

    function Recorder:StartRecording()
        if self.playing then self:StopPlayback() end
        local _, root = recorderCharacter()
        if not root then recorderNotify("character not ready") return false end
        self.samples = {}
        self.elapsed = 0
        self.sampleClock = 0
        self.recording = true
        self.status = "recording"
        self:Capture(root, true)
        recorderNotify("recording started")
        return true
    end

    function Recorder:Capture(root, force)
        if not root or not root.Parent then return end
        local cf = root.CFrame
        local values = {cf:GetComponents()}
        self.samples[#self.samples + 1] = {
            t = self.elapsed,
            cf = values,
            v = {root.AssemblyLinearVelocity.X, root.AssemblyLinearVelocity.Y, root.AssemblyLinearVelocity.Z},
        }
    end

    function Recorder:StopRecording()
        if not self.recording then return end
        self.recording = false
        self.status = "ready"
        recorderNotify("recording stopped (" .. #self.samples .. " samples)")
    end

    function Recorder:StopPlayback()
        self.playing = false
        self.status = (#self.samples > 0) and "ready" or "idle"
        self.playbackIndex = 1
        self.replayClock = 0
        local humanoid = self.playbackHumanoid
        pcall(function()
            if humanoid and humanoid.Parent and self.playbackAutoRotate ~= nil then
                humanoid.AutoRotate = self.playbackAutoRotate
            end
        end)
        self.playbackRoot = nil
        self.playbackHumanoid = nil
        self.playbackAutoRotate = nil
    end

    function Recorder:StartPlayback()
        if self.recording then self:StopRecording() end
        if #self.samples < 2 then recorderNotify("record or load a route first") return false end
        local _, root, humanoid = recorderCharacter()
        if not root then recorderNotify("character not ready") return false end
        self.playing = true
        self.status = "playing"
        self.playbackIndex = 1
        self.replayClock = 0
        self.playbackRoot = root
        self.playbackHumanoid = humanoid
        self.playbackAutoRotate = humanoid.AutoRotate
        humanoid.AutoRotate = false
        recorderNotify("playback started")
        return true
    end

    function Recorder:Save(name)
        name = validRecordingName(name)
        if name == "" then recorderNotify("enter a file name") return false end
        if #self.samples < 1 then recorderNotify("no samples to save") return false end
        if not (writefile and HttpService) then recorderNotify("file API unavailable") return false end
        ensureRecorderFolder()
        local path = self.folder .. "/" .. name .. ".json"
        local payload = {
            version = 1,
            placeId = game.PlaceId,
            recordedAt = os.time(),
            samples = self.samples,
        }
        local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
        if not ok then recorderNotify("encode failed") return false end
        local wrote = pcall(writefile, path, encoded)
        if not wrote then recorderNotify("save failed") return false end
        self.activeName = name
        recorderNotify("saved " .. name)
        return true
    end

    function Recorder:Load(name)
        name = validRecordingName(name)
        if name == "" then recorderNotify("enter a file name") return false end
        if not (readfile and isfile and HttpService) then recorderNotify("file API unavailable") return false end
        local path = self.folder .. "/" .. name .. ".json"
        if not isfile(path) then recorderNotify("file not found: " .. name) return false end
        local ok, raw = pcall(readfile, path)
        if not ok then recorderNotify("read failed") return false end
        local decodedOk, payload = pcall(function() return HttpService:JSONDecode(raw) end)
        if not decodedOk or type(payload) ~= "table" or type(payload.samples) ~= "table" then
            recorderNotify("invalid recording")
            return false
        end
        local cleaned = {}
        for _, sample in ipairs(payload.samples) do
            if type(sample) == "table" and type(sample.t) == "number" and type(sample.cf) == "table" and #sample.cf == 12 then
                local good = true
                for i = 1, 12 do if type(sample.cf[i]) ~= "number" then good = false break end end
                if good then cleaned[#cleaned + 1] = {t = sample.t, cf = sample.cf, v = sample.v} end
            end
        end
        if #cleaned < 2 then recorderNotify("recording has too few valid samples") return false end
        table.sort(cleaned, function(a, b) return a.t < b.t end)
        self.samples = cleaned
        self.activeName = name
        self.status = "ready"
        recorderNotify("loaded " .. name .. " (" .. #cleaned .. " samples)")
        return true
    end

    function Recorder:Delete(name)
        name = validRecordingName(name)
        if name == "" then recorderNotify("enter a file name") return false end
        local path = self.folder .. "/" .. name .. ".json"
        if not (isfile and delfile) or not isfile(path) then recorderNotify("file not found") return false end
        local ok = pcall(delfile, path)
        if ok then recorderNotify("deleted " .. name) end
        return ok
    end

    local function frameFromSample(sample)
        return CFrame.new(table.unpack(sample.cf))
    end

    _R.Heartbeat:Connect(function(dt)
        if Recorder.recording then
            local _, root = recorderCharacter()
            if not root then Recorder:StopRecording() return end
            Recorder.elapsed = Recorder.elapsed + dt
            Recorder.sampleClock = Recorder.sampleClock + dt
            local interval = math.clamp(tonumber(M.recorder_interval) or 0.05, 0.02, 0.25)
            if Recorder.sampleClock >= interval then
                Recorder.sampleClock = Recorder.sampleClock % interval
                Recorder:Capture(root)
            end
        end

        if not Recorder.playing then return end
        local root = Recorder.playbackRoot
        local humanoid = Recorder.playbackHumanoid
        if not root or not root.Parent or not humanoid or not humanoid.Parent then
            Recorder:StopPlayback()
            return
        end
        local samples = Recorder.samples
        if #samples < 2 then Recorder:StopPlayback() return end
        Recorder.replayClock = Recorder.replayClock + dt * math.clamp(tonumber(M.recorder_playback_speed) or 1, 0.1, 5)
        local finalTime = samples[#samples].t
        if Recorder.replayClock >= finalTime then
            if M.recorder_loop then
                Recorder.replayClock = 0
                Recorder.playbackIndex = 1
            else
                root.CFrame = frameFromSample(samples[#samples])
                Recorder:StopPlayback()
                pcall(function() humanoid.AutoRotate = Recorder.playbackAutoRotate end)
                recorderNotify("playback complete")
                return
            end
        end
        local index = math.clamp(Recorder.playbackIndex, 1, #samples - 1)
        while index < #samples - 1 and samples[index + 1].t < Recorder.replayClock do index = index + 1 end
        Recorder.playbackIndex = index
        local a, b = samples[index], samples[index + 1]
        local span = math.max(0.0001, b.t - a.t)
        local alpha = math.clamp((Recorder.replayClock - a.t) / span, 0, 1)
        local ok = pcall(function() root.CFrame = frameFromSample(a):Lerp(frameFromSample(b), alpha) end)
        if not ok then
            Recorder:StopPlayback()
            pcall(function() humanoid.AutoRotate = Recorder.playbackAutoRotate end)
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if Recorder.playing then Recorder:StopPlayback() end
        if Recorder.recording then Recorder:StopRecording() end
    end)

    -- Append controls to the existing Player page; all other UI remains intact.
    currentScroll = pages.player
    sec("MOVEMENT RECORDER")
    tg("movement recorder enabled", function() return M.recorder_enabled end, function(v)
        M.recorder_enabled = v
        if not v then
            if Recorder.recording then Recorder:StopRecording() end
            if Recorder.playing then
                local humanoid = Recorder.playbackHumanoid
                Recorder:StopPlayback()
                pcall(function() if humanoid then humanoid.AutoRotate = Recorder.playbackAutoRotate end end)
            end
        end
    end)
    tg("recorder loop playback", function() return M.recorder_loop end, function(v) M.recorder_loop = v end)
    sd("record interval", function() return M.recorder_interval end, function(v) M.recorder_interval = v end, 0.02, 0.25, 0.01, "s")
    sd("playback speed", function() return M.recorder_playback_speed end, function(v) M.recorder_playback_speed = v end, 0.1, 5, 0.1, "x")
    local recorderName = "route_1"
    inp("recording file name", function() return recorderName end, function(v) recorderName = validRecordingName(v) end, "route_1")
    btn("start recording", function()
        if not M.recorder_enabled then recorderNotify("enable the recorder first") return end
        Recorder:StartRecording()
    end)
    btn("stop recording", function() Recorder:StopRecording() end)
    btn("play recording", function()
        if not M.recorder_enabled then recorderNotify("enable the recorder first") return end
        Recorder:StartPlayback()
    end)
    btn("stop playback", function()
        local humanoid = Recorder.playbackHumanoid
        Recorder:StopPlayback()
        pcall(function() if humanoid then humanoid.AutoRotate = Recorder.playbackAutoRotate end end)
    end)
    btn("save recording", function() Recorder:Save(recorderName) end)
    btn("load recording", function() Recorder:Load(recorderName) end)
    btn("delete recording", function() Recorder:Delete(recorderName) end)

    getgenv().RIVALS_MOVEMENT_RECORDER = Recorder
end

