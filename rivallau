local silent_state={last_target_pos=nil,last_t=0}
local old_raycast=utility.Raycast
utility.Raycast=function(...)
    if CFG.silent_aim.enable and debug.info(3,"n")=="StartShooting" then
        if math.random(1,100)<=CFG.silent_aim.hit_chance then
            local tgt=get_closest(CFG.silent_aim.fov_radius)
            if tgt then
                local pos=resolve_aim_part(tgt,CFG.silent_aim.closest_part)
                if pos then
                    silent_state.last_target_pos=pos
silent_state.last_t=tick()
                    local args={...}
args[3]=pos
                    return old_raycast(table.unpack(args))
                end
            end
        end
    end
    return old_raycast(...)
end

