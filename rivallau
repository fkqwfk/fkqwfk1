do
    local opt=CFG.optimizations
    local pcl={ParticleEmitter=true,Trail=true,Smoke=true,Fire=true,Sparkles=true}
    local psl={BloomEffect=true,BlurEffect=true,ColorCorrectionEffect=true,SunRaysEffect=true,DepthOfFieldEffect=true}
    local ps,ts,pss=setmetatable({},{__mode="k"}),setmetatable({},{__mode="k"}),setmetatable({},{__mode="k"})
    local function ap(i,on) if not pcl[i.ClassName] then return end
if on then if ps[i]==nil then ps[i]=i.Enabled end
i.Enabled=false elseif ps[i]~=nil then i.Enabled=ps[i]
ps[i]=nil end end
    local function at(i,on) if not (i:IsA("Decal") or i:IsA("Texture")) then return end
if on then if ts[i]==nil then ts[i]=i.Transparency end
i.Transparency=1 elseif ts[i]~=nil then i.Transparency=ts[i]
ts[i]=nil end end
    local function apo(i,on) if not psl[i.ClassName] then return end
if on then if pss[i]==nil then pss[i]=i.Enabled end
i.Enabled=false elseif pss[i]~=nil then i.Enabled=pss[i]
pss[i]=nil end end
    local scanning=false
    local function scan()
        if scanning then return end
scanning=true
        task.spawn(function()
            local l=workspace:GetDescendants()
            for i=1,#l do ap(l[i],opt.no_particles); at(l[i],opt.no_textures); if i%800==0 then task.wait() end end
            scanning=false
        end)
    end
    workspace.DescendantAdded:Connect(function(i) if opt.no_particles then ap(i,true) end; if opt.no_textures then at(i,true) end end)
    Lighting.DescendantAdded:Connect(function(i) if opt.no_postfx then apo(i,true) end end)
    getgenv().riv_apply_opt=function(kind)
        if kind=="particles" or kind=="textures" then scan()
        elseif kind=="postfx" then for _,i in ipairs(Lighting:GetDescendants()) do apo(i,opt.no_postfx) end
        elseif kind=="shadows" then pcall(function() Lighting.GlobalShadows=not opt.no_shadows end)
        elseif kind=="quality" then pcall(function() settings().Rendering.QualityLevel=opt.low_quality and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic end)
        elseif kind=="atmosphere" then local a=Lighting:FindFirstChildOfClass("Atmosphere")
if a then a.Density=opt.no_atmosphere and 0 or 0.5 end
        elseif kind=="fpscap" then if setfpscap then pcall(setfpscap,opt.fps_cap_enable and opt.fps_cap or 1000) end end
    end
end

