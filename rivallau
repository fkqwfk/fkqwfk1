do
    local mats={Neon=Enum.Material.Neon,ForceField=Enum.Material.ForceField,Glass=Enum.Material.Glass,Chrome=Enum.Material.Metal,Ice=Enum.Material.Ice,Diamond=Enum.Material.Glass,Hologram=Enum.Material.ForceField,Ghost=Enum.Material.Neon,Obsidian=Enum.Material.Glass,["Gold Foil"]=Enum.Material.Foil,Frostbite=Enum.Material.Glacier,Plasma=Enum.Material.Neon,Molten=Enum.Material.CorrodedMetal,Prism=Enum.Material.Glass}
    local base_mats={ForceField=Enum.Material.ForceField,Neon=Enum.Material.Neon,Plastic=Enum.Material.Plastic,SmoothPlastic=Enum.Material.SmoothPlastic,Wood=Enum.Material.Wood,WoodPlanks=Enum.Material.WoodPlanks,Marble=Enum.Material.Marble,Slate=Enum.Material.Slate}
    local arm_kw={"arm","hand","sleeve","elbow","wrist","shoulder","finger","thumb","glove"}
    local tracked=setmetatable({},{__mode="k"})
    local arm_cache=setmetatable({},{__mode="k"})
    local vis_cache=setmetatable({},{__mode="k"})
    local hl_cache={}
    local body_t,item_t,clothes_t={},{},{}
    local function is_arm(p)
        local c=arm_cache[p]
if c~=nil then return c end
        local n=string.lower(p.Name)
local r=false
        for _,k in ipairs(arm_kw) do if string.find(n,k,1,true) then r=true
break end end
        if not r then
            local a=p.Parent
            while a and a~=first_person do local an=string.lower(a.Name)
if string.find(an,"arm",1,true) or string.find(an,"rig",1,true) then r=true
break end
a=a.Parent end
        end
        arm_cache[p]=r
return r
    end
    local function vvis(p) if vis_cache[p]==nil then vis_cache[p]=p.Transparency<1 and p.Size.Magnitude<40 end
return vis_cache[p] end
    local function st(part) if not tracked[part] then tracked[part]={Material=part.Material,Color=part.Color,Reflectance=part.Reflectance,Transparency=part.Transparency} end end
    local function rs(part) local s=tracked[part]
if s and part.Parent then part.Material=s.Material
part.Color=s.Color
part.Reflectance=s.Reflectance
part.Transparency=s.Transparency end
tracked[part]=nil end
    local function cl() for p in pairs(tracked) do rs(p) end end
    local function paint(p,mat,col,tr) p.Material=mats[mat] or Enum.Material.Neon
p.Reflectance=0
p.Transparency=math.clamp(tr or 0,0,1)
p.Color=col end
    local function dhl(p) if hl_cache[p] then hl_cache[p]:Destroy()
hl_cache[p]=nil end end
    local function shl(p,cfg)
        local hl=hl_cache[p]
        if not hl or not hl.Parent then hl=Instance.new("Highlight")
hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
hl.Adornee=p
hl.Parent=p
hl_cache[p]=hl end
        hl.FillColor=cfg.color
hl.FillTransparency=cfg.transparency
hl.OutlineColor=cfg.outline_color
hl.OutlineTransparency=cfg.outline_transparency
    end
    local function bst(t,p) if not t[p] then t[p]={material=p.Material,color=p.Color,transparency=p.Transparency} end end
    local function brs(t) for p,s in pairs(t) do if p.Parent then p.Material=s.material
p.Color=s.color
p.Transparency=s.transparency end
t[p]=nil end end
    local function bap(t,p,cfg)
        bst(t,p)
        if cfg.material_enable then p.Material=base_mats[cfg.material] or Enum.Material.Plastic else p.Material=t[p].material end
        if cfg.color_enable then p.Color=cfg.color else p.Color=t[p].color end
        p.Transparency=math.clamp((cfg.transparency or 0)/100,0,1)
    end
    local function rclothes()
        for i,tmpl in pairs(clothes_t) do
            if i.Parent then
                if i:IsA("Shirt") then i.ShirtTemplate=tmpl
                elseif i:IsA("Pants") then i.PantsTemplate=tmpl
                elseif i:IsA("ShirtGraphic") then i.Graphic=tmpl end
            end
            clothes_t[i]=nil
        end
    end
    local function dclothes(c)
        for _,i in ipairs(c:GetDescendants()) do
            if i:IsA("Shirt") then if clothes_t[i]==nil then clothes_t[i]=i.ShirtTemplate end
i.ShirtTemplate=""
            elseif i:IsA("Pants") then if clothes_t[i]==nil then clothes_t[i]=i.PantsTemplate end
i.PantsTemplate=""
            elseif i:IsA("ShirtGraphic") then if clothes_t[i]==nil then clothes_t[i]=i.Graphic end
i.Graphic="" end
        end
    end
    RunService.Heartbeat:Connect(function()
        local cfg=CFG.viewmodel_chams; local wc,ac=cfg.weapon_chams,cfg.arm_chams; local wh,ah=cfg.weapon_highlight,cfg.arm_highlight
        if not (wc.enable or ac.enable or wh.enable or ah.enable) then
            if next(tracked) then cl() end
            for p in pairs(hl_cache) do dhl(p) end
        else
            for _,part in ipairs(first_person:GetDescendants()) do
                if part:IsA("BasePart") and vvis(part) then
                    local arm=is_arm(part)
                    if arm and ac.enable then
                        st(part)
                        if ac.invisible then part.Transparency=1
                        else paint(part,ac.material,ac.color,ac.transparency) end
                    elseif not arm and wc.enable then st(part); paint(part,wc.material,wc.color,wc.transparency)
                    else rs(part) end
                    if arm and ah.enable then shl(part,ah)
                    elseif not arm and wh.enable then shl(part,wh)
                    else dhl(part) end
                end
            end
        end
        local vc=CFG.viewmodel_custom; local ch=LocalPlayer.Character
        if not vc.enable then brs(body_t); brs(item_t); rclothes()
        else
            if vc.appearance and ch then
                for _,p in ipairs(ch:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name~="HumanoidRootPart" and vvis(p) then bap(body_t,p,vc.body) end
                end
                if vc.body.disable_clothes then dclothes(ch) elseif next(clothes_t) then rclothes() end
            else brs(body_t); rclothes() end
            if first_person and first_person:IsDescendantOf(workspace) then
                for _,p in ipairs(first_person:GetDescendants()) do
                    if p:IsA("BasePart") and not is_arm(p) and vvis(p) then bap(item_t,p,vc.item) end
                end
            else brs(item_t) end
        end
    end)
    local old_off={}
    local stored=false
    RunService.Heartbeat:Connect(function()
        if CFG.viewmodel_offsets.enable then
            if not stored then
                for i,vm in pairs(item_lib.ViewModels) do if vm.RootPartOffset then old_off[i]=vm.RootPartOffset end end
                stored=true
            end
            for i,v in pairs(item_lib.ViewModels) do
                if old_off[i] then
                    v.RootPartOffset=CFrame.new(old_off[i].X+CFG.viewmodel_offsets.x,old_off[i].Y+CFG.viewmodel_offsets.y,old_off[i].Z+CFG.viewmodel_offsets.z)
                end
            end
        else
            if stored then
                for i,vm in pairs(item_lib.ViewModels) do if old_off[i] then vm.RootPartOffset=old_off[i] end end
                stored=false
            end
        end
    end)
end

