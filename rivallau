UserInputService.InputChanged:Connect(function(input)
    if toggleDrag and (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement) then
        local delta=input.Position-toggleStart
        if math.abs(delta.X)>6 or math.abs(delta.Y)>6 then toggleMoved=true end
        if IS_MOBILE or toggleMoved then
            local v=Camera.ViewportSize; local sz=reopen.AbsoluteSize
            reopen.Position=UDim2.fromOffset(math.clamp(togglePos.X.Offset+delta.X,0,math.max(0,v.X-sz.X)),math.clamp(togglePos.Y.Offset+delta.Y,0,math.max(0,v.Y-sz.Y)))
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if toggleDrag and (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1) then
