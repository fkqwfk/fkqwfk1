do
    local PS=32
local pool={}
    local throwables={grenade=true,molotov=true,flashbang=true,["smoke grenade"]=true,satchel=true,["jump pad"]=true,["war horn"]=true,["flare gun"]=true}
    local function getP(i)
        local p=pool[i]
if p and p.Parent then return p end
        p=Instance.new("Part")
p.Anchored=true
p.CanCollide=false
p.CanQuery=false
p.CanTouch=false
        p.Shape=Enum.PartType.Ball
p.Size=Vector3.new(0.4,0.4,0.4)
p.Material=Enum.Material.Neon
p.Parent=workspace
        pool[i]=p
return p
    end
    local function hideFrom(n) for i=n,PS do local p=pool[i]
if p then p.Transparency=1 end end end
    local function arc(sp,vel,g,dt,steps,params)
        local pts={sp}
local pos=sp
local v=vel
        for _=1,steps do
            local np=pos+v*dt+g*(0.5*dt*dt)
            local h=params and workspace:Raycast(pos,np-pos,params)
            if h then pts[#pts+1]=h.Position
return pts end
            pts[#pts+1]=np
pos=np
v=v+g*dt
        end
        return pts
    end
    RunService.RenderStepped:Connect(function()
        local cfg=CFG.trajectory
        if not cfg.enable then hideFrom(1); return end
        local f=fighter_controller.LocalFighter; local it=f and f.EquippedItem; local n=it and it.Name
        if not (cfg.all_weapons or (n and throwables[string.lower(n)])) then hideFrom(1); return end
        local o=Camera.CFrame.Position
        local v=Camera.CFrame.LookVector*cfg.speed+Vector3.new(0,cfg.arc_up,0)
        local g=Vector3.new(0,-workspace.Gravity,0)
        local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude; p.FilterDescendantsInstances={LocalPlayer.Character}
        local pts=arc(o,v,g,0.07,PS-1,p)
        for i=1,#pts do local pp=getP(i); pp.Position=pts[i]; pp.Color=cfg.color; pp.Transparency=0 end
        hideFrom(#pts+1)
    end)
end

