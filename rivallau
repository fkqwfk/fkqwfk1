esp.getbounds=function(root,dist)
    local hrp2d=Camera:WorldToViewportPoint(root.Position)
    local clamped=math.min(dist,535)
    local refpos=root.Position+(Camera.CFrame.Position-root.Position).Unit*(dist-clamped)
    local ct=Camera:WorldToViewportPoint(refpos+mv3(0,3,0))
    local cb=Camera:WorldToViewportPoint(refpos-mv3(0,1,0))
    local cs=(cb.Y-ct.Y)/2
    local w,h=mc(cs*1.5),mc(cs*3.2)
    local at=Camera:WorldToViewportPoint(root.Position+mv3(0,3,0))
    if w<4 or h<4 then return nil end
    return mc(hrp2d.X-cs*0.75),mc(at.Y),w,h
end

