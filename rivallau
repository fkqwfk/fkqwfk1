--// DESYNC + RAGEBOT
local Desync={active=false,conn=nil,server=nil,client=nil,fighter=LocalFighter}
local ref_cam_update=camera_controller.Update
camera_controller.Update=function(...)
    if Desync.active and Desync.fighter and Desync.fighter.Entity.RootPart and Desync.client then
        Desync.fighter.Entity.RootPart.CFrame=Desync.client
    end
    return ref_cam_update(...)
end
function Desync:Start(target)
    if self.active or not self.fighter or not self.fighter.Entity.RootPart or not LocalPlayer.Character then return end
    self.active=true
    self.conn=RunService.Heartbeat:Connect(function()
        if not self.active then if self.conn then self.conn:Disconnect(); self.conn=nil end; return end
        local tr=target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if not tr or not self.fighter or not self.fighter.Entity.RootPart then
            if self.conn then self.conn:Disconnect(); self.conn=nil end
            if self.client and self.fighter and self.fighter.Entity.RootPart then self.fighter.Entity.RootPart.CFrame=self.client end
            self.active=false; self.client=nil; self.server=nil; return
        end
        self.client=self.fighter.Entity.RootPart.CFrame
        local item=self.fighter.EquippedItem; if not item then return end
        if is_deflecting(target) or has_riot(target) then self.server=Vector3.new(0,2^26,0); return end
        if item.Name=="Slingshot" then self.server=Vector3.new(0,2^26,0)
        else self.server=tr.Position+Vector3.new(CFG.ragebot.x,CFG.ragebot.y,CFG.ragebot.z) end
        self.fighter.Entity.RootPart.CFrame=CFrame.new(self.server)
    end)
end
function Desync:Stop()
    if not self.active then return end
    if self.conn then self.conn:Disconnect()
self.conn=nil end
    if self.client and self.fighter and self.fighter.Entity.RootPart then self.fighter.Entity.RootPart.CFrame=self.client end
    self.active=false
self.server=nil
self.client=nil
end

local Rage={conn=nil,debounce=false}
function Rage:IsValid(plr)
    if not (plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health>0
        and plr:GetAttribute("EnvironmentID")==LocalPlayer:GetAttribute("EnvironmentID")) then return false end
    if not same_environment(plr) then return false end
    if CFG.ragebot.ffa_mode then return true end
    return LocalPlayer:GetAttribute("TeamID")~=plr:GetAttribute("TeamID")
end
function Rage:GetClosest()
