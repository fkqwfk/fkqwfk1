function Rage:Start()
    if self.conn then return end
    self.conn=RunService.Heartbeat:Connect(function()
        if not CFG.ragebot.enable then self:Stop(); return end
        local target=self:GetClosest(); if not target then Desync:Stop(); return end
        local f=fighter_controller.LocalFighter; if not f then Desync:Stop(); return end
        local item=f.EquippedItem; if not item then Desync:Stop(); return end
        local tf=fighter_controller:GetFighter(target); if not tf then Desync:Stop(); return end
        local vm=item.ViewModel; if not vm then Desync:Stop(); return end
        if item:Get("Ammo") and item:Get("Ammo")>0 and not vm:IsAnimationPlaying("Reload") then
            if self.debounce==false then self.debounce=os.clock()+0.5; return end
            if type(self.debounce)=="number" and os.clock()<self.debounce then return end
            if type(self.debounce)=="number" then self.debounce=true end
            Desync:Start(target)
            if Desync.server then self:Fire(target) end
        else
            if not vm:IsAnimationPlaying("Reload") then setthreadidentity(2); item:Input("StartReloading"); setthreadidentity(7) end
        end
    end)
end
function Rage:Stop()
    if self.conn then self.conn:Disconnect()
self.conn=nil end
    self.debounce=false
Desync:Stop()
end

