--// CONFIG SYSTEM
local ConfigSystem = {}
do
    ConfigSystem.Folder = "Rivals"
    ConfigSystem.FilesFolder = ConfigSystem.Folder .. "/configs"
    ConfigSystem.AutoloadFile = ConfigSystem.Folder .. "/autoload.txt"
    local function ed(p) pcall(function() if makefolder and isfolder and not isfolder(p) then makefolder(p) end end) end
    function ConfigSystem:BuildTree() ed(ConfigSystem.Folder)
ed(ConfigSystem.FilesFolder) end
    local function ser(t) local o={} for k,v in pairs(t) do if typeof(v)=="Color3" then o[k]=v:ToHex() elseif type(v)=="table" then o[k]=ser(v) else o[k]=v end end return o end
    local function dm(t,d) if type(t)~="table" or type(d)~="table" then return t end for k,v in pairs(d) do if type(t[k])=="table" and type(v)=="table" then dm(t[k],v) elseif t[k]~=nil then if typeof(t[k])=="Color3" and type(v)=="string" then local ok,c=pcall(Color3.fromHex,v)
if ok then t[k]=c end else t[k]=v end end end return t end
    function ConfigSystem:Save(name)
        if not name or name:gsub("%s","")=="" then return false,"empty" end
        self:BuildTree()
        local path=self.FilesFolder.."/"..name..".json"
        local ok,enc=pcall(function() return HttpService:JSONEncode(ser(CFG)) end)
        if not ok then return false,"encode" end
        if not pcall(writefile,path,enc) then return false,"write" end
        return true
    end
    function ConfigSystem:Load(name)
        if not name or name=="" then return false,"empty" end
        local path=self.FilesFolder.."/"..name..".json"
        if not isfile or not isfile(path) then return false,"not found" end
        local ok,c=pcall(readfile,path)
if not ok then return false,"read" end
        local okd,dec=pcall(function() return HttpService:JSONDecode(c) end)
        if not okd or type(dec)~="table" then return false,"decode" end
        dm(CFG,dec)
return true
    end
    function ConfigSystem:Delete(n) pcall(delfile,self.FilesFolder.."/"..n..".json") end
    function ConfigSystem:List()
        local o={}
local ok,l=pcall(listfiles,self.FilesFolder)
        if ok and type(l)=="table" then for _,f in ipairs(l) do local n=f:match("([^/\\]+)%.json$")
if n then o[#o+1]=n end end end
        table.sort(o)
return o
    end
    function ConfigSystem:SetAutoload(n) self:BuildTree()
pcall(writefile,self.AutoloadFile,n or "") end
    function ConfigSystem:ClearAutoload() pcall(delfile,self.AutoloadFile) end
    function ConfigSystem:GetAutoload() if isfile and isfile(self.AutoloadFile) then local ok,c=pcall(readfile,self.AutoloadFile)
if ok and c and c~="" then return c end end return nil end
    ConfigSystem:BuildTree()
end
getgenv().RIVALS_CONFIG = ConfigSystem

--// HELPERS
local deflecting = {}
local function is_deflecting(p) return deflecting[p] end
local function has_riot(p) return workspace.ViewModels:FindFirstChild(p.Name.." - Riot Shield - Riot Shield")~=nil end
local function check_wall(part)
    local ray=Ray.new(Camera.CFrame.Position,part.Position-Camera.CFrame.Position)
    return not workspace:FindPartOnRayWithIgnoreList(ray,{LocalPlayer.Character,part.Parent})
end
local function same_environment(plr)
    if plr==LocalPlayer then return false end
    if not (plr and plr.Character and plr.Character.Parent) then return false end
    if CFG.targeting.chunk_check then
        local me,hi=LocalPlayer:GetAttribute("EnvironmentID"),plr:GetAttribute("EnvironmentID")
        if me~=nil and hi~=nil and me~=hi then return false end
    end
    local r=CFG.targeting.chunk_range
    if r and r>0 then
        local mr=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hr=plr.Character:FindFirstChild("HumanoidRootPart")
        if mr and hr and (hr.Position-mr.Position).Magnitude>r then return false end
    end
    return true
end
local function closest_part(plr)
    local mp=Vector2.new(Mouse.X,Mouse.Y)
local best,bp=math.huge,nil
    for _,v in ipairs(plr.Character:GetChildren()) do
        if v:IsA("BasePart") then
            local pos,on=Camera:WorldToViewportPoint(v.Position)
            if on then local d=(mp-Vector2.new(pos.X,pos.Y)).Magnitude
if d<=best then best,bp=d,v end end
        end
    end
    return bp
end
local function get_closest(fov_override)
    local fov=fov_override or CFG.silent_aim.fov_radius
    local closest=CFG.targeting.max_distance
local target
    local c=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,v in ipairs(Players:GetPlayers()) do
        if v~=LocalPlayer and v.Character and v.Character:FindFirstChild(CFG.targeting.part) and v.Character:FindFirstChildOfClass("Humanoid") and v.Character.Humanoid.Health>0 then
            if same_environment(v) and not is_deflecting(v) and v:GetAttribute("TeamID")~=LocalPlayer:GetAttribute("TeamID")
                and not (CFG.targeting.riot_shield and has_riot(v))
                and not (CFG.targeting.anti_katana and is_deflecting(v))
                and not ((CFG.targeting.wall_check or CFG.targeting.visible_only) and not check_wall(v.Character[CFG.targeting.part])) then
                local pos,on=Camera:WorldToViewportPoint(v.Character[CFG.targeting.part].Position)
                if on then local d=(c-Vector2.new(pos.X,pos.Y)).Magnitude
if d<closest and d<=fov then target,closest=v,d end end
            end
        end
    end
    return target
end
local function get_closest2(fov_override)
    local fov=fov_override or CFG.aimbot.fov_radius
    local closest=CFG.targeting.max_distance
local target
    local c=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,v in ipairs(Players:GetPlayers()) do
        if v~=LocalPlayer and v.Character and v.Character:FindFirstChild(CFG.targeting.part) and v.Character:FindFirstChildOfClass("Humanoid") and v.Character.Humanoid.Health>0 then
            if same_environment(v) and not is_deflecting(v) and v:GetAttribute("TeamID")~=LocalPlayer:GetAttribute("TeamID")
                and not (CFG.targeting.riot_shield and has_riot(v))
                and not ((CFG.targeting.wall_check or CFG.targeting.visible_only) and not check_wall(v.Character[CFG.targeting.part])) then
                local pos,on=Camera:WorldToViewportPoint(v.Character[CFG.targeting.part].Position)
                if on then local d=(c-Vector2.new(pos.X,pos.Y)).Magnitude
if d<closest and d<fov then target,closest=v,d end end
            end
        end
    end
    return target
end
local function resolve_aim_part(plr,use_closest)
    if not plr or not plr.Character then return nil end
    if use_closest then local p=closest_part(plr)
if p then return p.Position end end
    local ch=plr.Character
    local p=ch:FindFirstChild(CFG.targeting.part) or ch:FindFirstChild("HitboxHead") or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    return p and p.Position
end
local function GetMuzzlePos()
    for _,P in ipairs(first_person:GetDescendants()) do
        if P.Name=="_muzzle" and P:IsA("Attachment") then local pos=Camera:WorldToViewportPoint(P.WorldPosition)
return Vector2.new(pos.X,pos.Y) end
    end
    return Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
end

--// PREDICTION
local Pred={enabled=false,mult=1.2,velocity=Vector3.zero,acceleration=Vector3.zero,last_pos=nil,last_t=0,vel_buffer={},max_samples=15}
function Pred:Reset() self.velocity=Vector3.zero
self.acceleration=Vector3.zero
self.last_pos=nil
self.vel_buffer={} end
function Pred:Update(target)
    if not self.enabled or not target or not target.Character then return self:Reset() end
    local root=target.Character:FindFirstChild("HumanoidRootPart")
if not root then return end
    local now=tick()
local dt=now-self.last_t
    if dt>0 and dt<0.1 then
        local pos=root.Position
        if self.last_pos then
            local iv=(pos-self.last_pos)/dt
            if self.velocity.Magnitude>0.1 then self.acceleration=self.acceleration:Lerp((iv-self.velocity)/dt,0.5) end
            table.insert(self.vel_buffer,1,iv)
if #self.vel_buffer>self.max_samples then table.remove(self.vel_buffer) end
            local sum,ws=Vector3.zero,0
            for i,v in ipairs(self.vel_buffer) do local w=math.exp(-(i-1)*0.3)
sum=sum+v*w
ws=ws+w end
            self.velocity=sum/ws
        end
        self.last_pos=pos
self.last_t=now
    end
end

