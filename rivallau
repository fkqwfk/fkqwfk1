        local mid=(from+to)*0.5
        local function clear(ap) local a=workspace:Raycast(from,ap-from,p); if a and (a.Position-from).Magnitude<(ap-from).Magnitude-1 then return false end local b=workspace:Raycast(ap,to-ap,p); if b and (b.Position-ap).Magnitude<(to-ap).Magnitude-1 then return false end return true end
        local dirs={up,(up+right*0.6).Unit,(up-right*0.6).Unit,right,-right}
        local hs={maxH*0.7,maxH,maxH*1.5}
        local bd,bh
        for _,d in ipairs(dirs) do for _,h in ipairs(hs) do if clear(mid+d*h) then bd,bh=d,h; break end end if bd then break end end
        if not bd then bd,bh=up,math.min(maxH*1.5,dist*0.4) end
        local ref=math.abs(bd.Y)<0.99 and Vector3.yAxis or Vector3.xAxis
