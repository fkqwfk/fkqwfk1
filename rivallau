local function prettyPath(path)
    return path:gsub("_"," "):gsub("^%l",string.upper)
end
local function addLeaf(path, parent, key, value)
    local name=prettyPath(path)
    local function getter() return parent[key] end
    local function setter(v)
        parent[key]=v
        if path=="ragebot.prediction" then Pred.enabled=v end
        if path=="world.skybox" or path=="world.skybox_selected"
            or path=="world.skybox_remove_sun" or path=="world.skybox_remove_moon"
            or path=="world.skybox_remove_stars" then
            pcall(function() getgenv().riv_apply_skybox() end)
        end
        if path=="world.atmosphere" then pcall(function() getgenv().riv_apply_atmo() end) end
        if path=="textures.enable" then
            pcall(function()
                if v then getgenv().riv_enable_textures()
                else getgenv().riv_disable_textures() end
            end)
        end
        if path:match("^optimizations%.") then
            local k=path:match("^optimizations%.(.+)$")
            local map={no_particles="particles",no_shadows="shadows",no_postfx="postfx",
                no_textures="textures",low_quality="quality",no_atmosphere="atmosphere",
                fps_cap_enable="fpscap"}
            if map[k] then pcall(function() getgenv().riv_apply_opt(map[k]) end) end
        end
    end
    if type(value)=="boolean" then
        tg(name,getter,setter)
    elseif type(value)=="number" then
        local step=math.abs(value)<1 and 0.05 or (math.abs(value)<10 and 0.25 or 1)
        local mn,mx=-1000,1000
        if key:find("transparency") then mn,mx,step=0,1,0.05
        elseif key:find("chance") then mn,mx,step=0,100,5
        elseif key:find("fov") then mn,mx,step=1,1000,10
        elseif key:find("speed") or key:find("mult") then mn,mx,step=0,500,step
        elseif key=="x" or key=="y" or key=="z" then mn,mx,step=-100,100,0.5
        elseif key:find("color") then return
        elseif value>=0 then mn=0 end
        sd(name,getter,setter,mn,mx,step)
    elseif typeof(value)=="Color3" then
        colorOpt(name,getter,setter)
    elseif type(value)=="string" then
        local choices=optionSets[key]
        if key=="texture" then choices=optionSets.texture end
        if choices then
            local found=false
            for _,v in ipairs(choices) do if v==value then found=true end end
            if not found then table.insert(choices,1,value) end
            opt(name,getter,setter,choices)
        else
            inp(name,getter,setter,value)
        end
    end
end

