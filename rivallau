    for _,c in ipairs(vm:GetChildren()) do
        local parts={}
for p in c.Name:gmatch("[^-]+") do parts[#parts+1]=p:match("^%s*(.-)%s*$") end
        if #parts>=2 and parts[1]==player.Name then return parts[2] end
