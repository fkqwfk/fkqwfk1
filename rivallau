local function walkSettings(node,prefix)
    local keys={}
    for k in pairs(node) do
        if type(k)=="string" then keys[#keys+1]=k end
    end
    table.sort(keys)
    for _,key in ipairs(keys) do
        local value=node[key]
        local path=prefix=="" and key or (prefix.."."..key)
        if type(value)=="table" then
            if next(value) and not path:match("%.select$") and not path:match("%.loadout$") then
                sec(path:upper())
                walkSettings(value,path)
            end
        else
            addLeaf(path,node,key,value)
        end
    end
end
