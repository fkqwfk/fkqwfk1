    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and self:IsValid(plr) then
            local d=LocalPlayer:DistanceFromCharacter(plr.Character.HumanoidRootPart.Position)
            if d<bd then best,bd=plr,d end
        end
    end
    return best
end
