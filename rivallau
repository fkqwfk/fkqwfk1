--// ---------- Sound ESP ----------
do
    local sound_esp_folder = Instance.new("Folder")
    sound_esp_folder.Name = "RIVALS_SoundESP"
    sound_esp_folder.Parent = workspace
    local hooks = setmetatable({}, {__mode = "k"})
    local lastPlayed = setmetatable({}, {__mode = "k"})
    local effects = {}

    local function passesSource(src, char)
        if src == "All" or char == nil then return true end
        local isSelf = char == LocalPlayer.Character
        if src == "Self" then return isSelf end
        if isSelf then return false end
        local plr = Players:GetPlayerFromCharacter(char)
        if plr then
            local sameTeam = plr:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID")
            if src == "Enemies" and sameTeam then return false end
            if src == "Team" and not sameTeam then return false end
        end
        return true
    end

    local function spawnVisual(cfg, src, parent)
        local pos = src.Parent and src.Parent.Position or Vector3.zero
        local vol = src.Volume or 1
        local dist = (_cam.CFrame.Position - pos).Magnitude
        local rolloff = src.RollOffMaxDistance or 0
        local atten = vol
        if rolloff > 0 then atten = vol * (1 - math.clamp(dist / rolloff, 0, 1)) end
        atten = math.clamp(atten, 0, 1)
        if atten < CFG.sound_esp.min_volume then return end
        local isFoot = parent and parent:FindFirstChild("LeftFoot") ~= nil
        local kind = isFoot and "footsteps" or "other"
        local mode = CFG.sound_esp[kind .. "_mode"]
        local useLoud = CFG.sound_esp[kind .. "_use_loudness"]
        local baseCol = CFG.sound_esp[kind .. "_color"]
        local col
        if useLoud then
            if atten <= 0.5 then col = Color3.new(atten * 2, 1, 0)
            else col = Color3.new(1, (1 - atten) * 2, 0) end
        else
            col = baseCol
        end
        local radius = 0.6 + 1.9 * atten
        local dur = 0.5 + 0.8 * atten

        if mode == "Circle" then
            local ad = Instance.new("CylinderHandleAdornment")
            ad.Adornee = workspace.Terrain
            ad.AlwaysOnTop = true
            ad.ZIndex = 5
            ad.Height = 0.05
            ad.Angle = 360
            ad.Radius = 0.01
            ad.InnerRadius = 0
            ad.CFrame = CFrame.new(pos) * CFrame.Angles(math.pi/2, 0, 0)
            ad.Color3 = col
            ad.Transparency = 0.2
            ad.Parent = sound_esp_folder
            table.insert(effects, {Adornment = ad, IsCircle = true, Elapsed = 0, Duration = dur, MaxRadius = radius})
        else
            local ad = Instance.new("BoxHandleAdornment")
            ad.Adornee = workspace.Terrain
            ad.AlwaysOnTop = true
            ad.ZIndex = 5
            ad.Size = Vector3.new(1.5, 0.15, 1.5) * radius
            ad.CFrame = CFrame.new(pos)
            ad.Color3 = col
            ad.Transparency = 0.2
            ad.Parent = sound_esp_folder
            table.insert(effects, {Adornment = ad, IsCircle = false, Elapsed = 0, Duration = dur, MaxRadius = radius})
        end
    end

    local function trackSound(sound)
        if hooks[sound] then return end
        hooks[sound] = true
        pcall(function()
            sound.Played:Connect(function()
                if not CFG.sound_esp.enable then return end
                local vol = sound.Volume or 0
                if vol <= 0 then return end
                local now = _clock()
                if lastPlayed[sound] and now - lastPlayed[sound] < 0.15 then return end
                lastPlayed[sound] = now
                local p = sound.Parent
                if not p then return end
                if not _isBasePart(p) and not p:IsA("Attachment") then return end
                local base = _isBasePart(p) and p or (p.Parent and p.Parent:IsA("BasePart") and p.Parent)
                if not base then return end
                local model = base:FindFirstAncestorOfClass("Model")
                if not passesSource(CFG.sound_esp.source, model) then return end
                local isFoot = model and (model:FindFirstChild("LeftFoot") ~= nil)
                local key = isFoot and "Footsteps" or "Other"
                if not CFG.sound_esp.types[key] then return end
                spawnVisual(CFG.sound_esp, sound, model)
            end)
        end)
    end

    workspace.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then trackSound(d) end
    end)
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Sound") then trackSound(d) end
    end

    _R.RenderStepped:Connect(function(dt)
        if #effects == 0 then return end
        for i = #effects, 1, -1 do
            local e = effects[i]
            e.Elapsed = e.Elapsed + dt
            local n = math.clamp(e.Elapsed / e.Duration, 0, 1)
            if e.IsCircle then
                local ad = e.Adornment
                local r = e.MaxRadius * (1 - (1 - n) ^ 5)
                ad.Radius = r
                ad.InnerRadius = math.max(0, r - 0.15)
                ad.Transparency = 0.2 + 0.8 * n ^ 4
            else
                e.Adornment.Transparency = 0.2 + 0.8 * n * n
            end
            if n >= 1 then
                pcall(function() e.Adornment:Destroy() end)
                table.remove(effects, i)
            end
        end
    end)
end

--// ---------- Movement 확장 ----------
do
    local M = CFG.movement
    local FlightMover = nil
    local function getMoveInput()
        if UserInputService:GetFocusedTextBox() then return Vector3.zero end
        local mv = Vector3.zero
        local cam = _cam.CFrame
        if UserInputService.KeyboardEnabled then
            local lv = cam.LookVector
local rv = cam.RightVector
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + lv end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - lv end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - rv end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + rv end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv = mv - Vector3.yAxis end
        end
        return mv
    end

    _R.Heartbeat:Connect(function()
        if not M.flight_enable then
            if FlightMover then
                pcall(function() FlightMover.Vel:Destroy(); FlightMover.Att:Destroy() end)
                FlightMover = nil
            end
            return
        end
        local ch = LocalPlayer.Character; if not ch then return end
        local root = ch:FindFirstChild("HumanoidRootPart"); if not root then return end
        local input = getMoveInput()
        if input.Magnitude > 0 then input = input.Unit end
        local v = input * M.flight_speed
        if not FlightMover then
            local att = Instance.new("Attachment"); att.Parent = root
            local lv = Instance.new("LinearVelocity")
            lv.RelativeTo = Enum.ActuatorRelativeTo.World
            lv.MaxForce = math.huge
            lv.VectorVelocity = v
            lv.Attachment0 = att
            lv.Parent = root
            FlightMover = {Att = att, Vel = lv}
        else
            FlightMover.Vel.VectorVelocity = v
            FlightMover.Att.WorldPosition = root.Position
        end
    end)

    _R.Heartbeat:Connect(function(dt)
        if not M.autostrafe_enable then return end
        local ch = LocalPlayer.Character; if not ch then return end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local root = ch:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        if hum:GetState() ~= Enum.HumanoidStateType.Freefall then return end
        local mv = getMoveInput()
        if mv.Magnitude > 0 then
            mv = mv.Unit
            local push = mv * (M.autostrafe_speed / 100) * dt * 60
            root.CFrame = root.CFrame + push
        end
    end)

    _R.Heartbeat:Connect(function()
        if not M.noclip_enable then return end
        local ch = LocalPlayer.Character; if not ch then return end
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)

    local longJumpArmed = false
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.Space then
            if M.longjump_enable and not longJumpArmed then
                longJumpArmed = true
                task.delay(0.25, function() longJumpArmed = false end)
            elseif M.longjump_enable and longJumpArmed then
                longJumpArmed = false
                pcall(function()
                    local ch = LocalPlayer.Character
                    if not ch then return end
                    local root = ch:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    local look = _cam.CFrame.LookVector
                    local dir = Vector3.new(look.X, 0, look.Z)
                    if dir.Magnitude < 0.001 then dir = Vector3.new(0, 0, -1) end
                    dir = dir.Unit
                    if M.longjump_mode == "Under Feet" then
                        dir = (dir * M.longjump_behind + Vector3.new(0, 4, 0)).Unit
                    end
                    root.AssemblyLinearVelocity = dir * M.longjump_force + Vector3.new(0, M.longjump_upward, 0)
                end)
            end
        end
    end)

    _R.Heartbeat:Connect(function()
        if not M.walkspeed_mult_enable then return end
        local ch = LocalPlayer.Character; if not ch then return end
        local hum = ch:FindFirstChildOfClass("Humanoid"); if not hum then return end
        hum.WalkSpeed = 16 * M.walkspeed_mult
    end)
end

