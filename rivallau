local function categoryForSection(name)
    if name=="RAGEBOT" then return "ragebot" end
    if name=="COMBAT" or name=="TARGETING" then return "combat" end
    if name=="ESP" or name=="VISUALS" or name=="VIEWMODEL" then return "visual" end
    if name=="CHARACTER" or name=="SPOOFERS" then return "player" end
    if name=="WORLD" then return "world" end
    if name=="MISC" or name=="OPTIMIZATIONS" then return "misc" end
    if name=="CONFIG" then return "config" end
    return currentCategory
end
