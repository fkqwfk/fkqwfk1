    if not ch or not ch.Parent then esp.hide(player)
return end
    local root=ch:FindFirstChild("HumanoidRootPart")
local hum=ch:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum or hum.Health<=0 then esp.hide(player)
return end
    local cfg=CFG.esp
    if cfg.world_check and not same_environment(player) then esp.hide(player)
return end
    if cfg.team_check and player:GetAttribute("TeamID")==LocalPlayer:GetAttribute("TeamID") then esp.hide(player)
return end
    local dist=(Camera.CFrame.Position-root.Position).Magnitude
    if dist>cfg.max_dist then esp.hide(player)
return end
    local _,on=Camera:WorldToViewportPoint(root.Position)
if not on then esp.hide(player)
return end
    local left,top,w,h=esp.getbounds(root,dist)
if not left then esp.hide(player)
return end
    local c=cache[player]
    local cbox,ctext,chp=c.box,c.text,c.bars.hp
    local vis=false
    if cfg.visible.enable then
        if (tickval-(c.visT or 0))>=0.05 then local ok,s=pcall(check_wall,root)
c.vis=ok and s==true
c.visT=tickval end
        vis=c.vis==true
    end
    local flash=cfg.filled.hit_flash and (tickval-(c.hitFlash or 0))<(cfg.filled.hit_time or 0.3)
    -- filled
    if cfg.filled.enable then
        local fb=cbox.filled
        fb.Visible=true
fb.BackgroundTransparency=cfg.filled.transparency
        fb.Position=udim(left,top)
fb.Size=udim(w,h)
        local fc1,fc2
        if flash then fc1,fc2=cfg.filled.hit_color,cfg.filled.hit_color
        elseif vis then fc1,fc2=cfg.visible.color,cfg.visible.color
        else fc1,fc2=cfg.filled.color_start,cfg.filled.color_end end
        if cbox.fc1~=fc1 or cbox.fc2~=fc2 then
            cbox.fc1,cbox.fc2=fc1,fc2
            cbox.filledgrad.Color=csn({csk(0,fc1),csk(1,fc2)})
        end
        cbox.filledgrad.Rotation=cfg.filled.animated and (math.sin(tickval*cfg.filled.speed)*90)+cfg.filled.rotation or cfg.filled.rotation
    else cbox.filled.Visible=false end
    -- highlight
    if cfg.highlight.enable and c.highlight then
        local hl=c.highlight
hl.Adornee=ch
        local hf=flash and cfg.filled.hit_color or (vis and cfg.visible.color or cfg.highlight.fill_color)
        hl.FillColor=hf
hl.OutlineColor=cfg.highlight.outline_color
        hl.FillTransparency=cfg.highlight.fill_transparency
hl.OutlineTransparency=cfg.highlight.outline_transparency
        hl.Enabled=true
    elseif c.highlight and c.highlight.Enabled then c.highlight.Enabled=false end
    -- box
    if cfg.box.enable then
        cbox.outline.Visible=true
cbox.outline.Color=cfg.box.outline
        cbox.outline.Position=mv2(left-1,top-1)
cbox.outline.Size=mv2(w+2,h+2)
        cbox.square.Visible=true
cbox.square.Color=vis and cfg.visible.color or cfg.box.color
        cbox.square.Thickness=cfg.box.thickness
        cbox.square.Position=mv2(left,top)
cbox.square.Size=mv2(w,h)
        cbox.inline.Visible=true
cbox.inline.Color=cfg.box.inline
        cbox.inline.Position=mv2(left+1,top+1)
cbox.inline.Size=mv2(w-2,h-2)
    else
        cbox.outline.Visible=false
cbox.square.Visible=false
cbox.inline.Visible=false
    end
    -- glow
    if cfg.glow.enable and cfg.box.enable then
        cbox.glow.Visible=true
        cbox.glow.ImageTransparency=cfg.glow.transparency
        cbox.glow.ImageColor3=cfg.glow.color_start
        cbox.glow.Position=udim(left-21,top-21)
cbox.glow.Size=udim(w+42,h+42)
        cbox.glowgrad.Rotation=cfg.glow.animated and (math.sin(tickval*cfg.glow.speed)*90)+cfg.glow.rotation or cfg.glow.rotation
    else cbox.glow.Visible=false end
    -- health
    if cfg.health.enable then
        local hp=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
        chp.lasthp=chp.lasthp+(hp-chp.lasthp)*0.1
        local fh=mk(h*chp.lasthp)
        local bx=left-cfg.health.width-cfg.health.gap
        chp.bg.Visible=true
chp.bg.Position=udim(bx,top)
chp.bg.Size=udim(cfg.health.width,h)
        chp.fill.Visible=true
chp.fill.Position=udim(bx,top+h-fh)
chp.fill.Size=udim(cfg.health.width,fh)
    else chp.bg.Visible=false
chp.fill.Visible=false end
    -- text
    local txtsize=cfg.text.size
    local gseq,gflow
    if cfg.text.gradient then
        gseq=csn({csk(0,cfg.text.gradient_color1),csk(0.5,cfg.text.gradient_color2),csk(1,cfg.text.gradient_color1)})
        gflow=cfg.text.flow and mv2((tickval*(cfg.text.flow_speed or 1))%2-1,0) or mv2(0,0)
    end
    local ln=ctext.name
    ln.Visible=cfg.text.name.enable
ln.Text=player.Name
    ln.TextColor3=gseq and Color3.new(1,1,1) or cfg.text.name.color
    ln.TextSize=txtsize
ln.Position=udim(left,top-13)
ln.Size=udim(w,12)
    apply_grad(ln,gseq,gflow)
    local dm=mc(dist*0.28)
    if dm~=chp.lastdist then chp.lastdist=dm
chp.lastdiststr=string.format("%dM",dm) end
    local ls=ctext.studs
    ls.Visible=cfg.text.studs.enable
ls.Text=chp.lastdiststr
    ls.TextColor3=gseq and Color3.new(1,1,1) or cfg.text.studs.color
    ls.TextSize=txtsize
ls.Position=udim(left,top+h+2)
ls.Size=udim(w,12)
    apply_grad(ls,gseq,gflow)
    local lt=ctext.tool
    if cfg.text.tool.enable then
        lt.Visible=true
lt.Text=esp.getweapon(player)
        lt.TextColor3=gseq and Color3.new(1,1,1) or cfg.text.tool.color
        lt.TextSize=txtsize
apply_grad(lt,gseq,gflow)
        local tp=cfg.text.tool.position
        if tp=="top" then lt.TextXAlignment=Enum.TextXAlignment.Center
