local Flickbot = {}
Flickbot.__index = Flickbot
function Flickbot.new()
    return setmetatable({
        _state="Idle", _selected=nil, _traj=nil, _idx=1,
        _elapsedMs=0, _totalMs=0, _bakedEnd=Vector3.zAxis, _timer=0, _held=false,
    }, Flickbot)
end
function Flickbot:_buildTrajectory(from, to, duration, curvature, humanness)
    local n = to - from
    local dist = n.Magnitude
    if dist < 1 then return {{X=to.X, Y=to.Y, T=duration}} end
    local samples = 16
    local pts = {}
    local perp = Vector2.new(-n.Y, n.X)
    if perp.Magnitude > 0 then perp = perp.Unit end
    for i = 0, samples do
        local t = i / samples
        local ease = 1 - (1 - t) ^ 5
        local x = from.X + n.X * ease
        local y = from.Y + n.Y * ease
        local bulge = math.sin(t * math.pi) * (curvature / 100) * dist
        x = x + perp.X * bulge
        y = y + perp.Y * bulge
        local h = (humanness / 100) * 3
        x = x + (math.random() - 0.5) * h
        y = y + (math.random() - 0.5) * h
        table.insert(pts, {X = x, Y = y, T = duration * t})
    end
    return pts
end
function Flickbot:_start()
    if self._state ~= "Idle" then return end
    local target = get_closest()
    if not target or not target.Character then return end
    local hitbox = target.Character:FindFirstChild("HitboxHead") or target.Character:FindFirstChild("HumanoidRootPart")
    if not hitbox then return end
    local sp, on = _cam:WorldToViewportPoint(hitbox.Position)
    if not on then return end
    local from = _cam.ViewportSize * 0.5
    local to = Vector2.new(sp.X, sp.Y)
    local pts = self:_buildTrajectory(from, to,
        CFG.flickbot.flick_duration, CFG.flickbot.curvature, CFG.flickbot.humanness)
    self._traj = pts
    self._idx = 1
    self._elapsedMs = 0
    self._totalMs = pts[#pts].T
    local lastRay = _cam:ViewportPointToRay(pts[#pts].X, pts[#pts].Y)
    self._bakedEnd = lastRay.Direction
    self._selected = {Target = target, Part = hitbox}
    self._state = "Flicking"
end
function Flickbot:_finishToCooldown()
    self._selected = nil
    self._traj = nil
    if CFG.flickbot.cooldown > 0 then
        self._state = "Cooldown"
        self._timer = CFG.flickbot.cooldown / 1000
    else
        self._state = "Idle"
    end
end
function Flickbot:Update(dt)
    if not CFG.flickbot.enable then
        if self._state ~= "Idle" then self._state = "Idle"
self._selected=nil
self._traj=nil end
        return
    end
    local s = self._state
    if s == "Flicking" then
        local pts = self._traj
        if not pts or not self._selected then self:_finishToCooldown()
return end
        if not self._selected.Part or not self._selected.Part.Parent then self:_finishToCooldown()
return end
        self._elapsedMs = self._elapsedMs + dt * 1000
        while self._idx < #pts and pts[self._idx + 1].T <= self._elapsedMs do
            self._idx = self._idx + 1
        end
        local a = pts[self._idx]
        local b = pts[self._idx + 1]
        local px, py, done
        if b == nil then px, py, done = a.X, a.Y, true
        else
            local t = 0
            if (b.T - a.T) > 0 then t = math.clamp((self._elapsedMs - a.T) / (b.T - a.T), 0, 1) end
            px, py, done = a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t, false
        end
        local dir = _cam:ViewportPointToRay(px, py).Direction
        if self._totalMs > 0 then
            local targetDir = (self._selected.Part.Position - _cam.CFrame.Position).Unit
            local alpha = math.clamp(self._elapsedMs / self._totalMs, 0, 1)
            dir = (dir + (targetDir - self._bakedEnd) * alpha).Unit
        end
        local ox, oy = CFrame.lookAt(Vector3.zero, dir):ToOrientation()
        pcall(function() camera_controller:MimicRotation(CFrame.fromOrientation(ox, oy, 0)) end)
        if done then
            if CFG.flickbot.shoot then
                self._state = "PostShot"
                self._timer = CFG.flickbot.shot_delay / 1000
            else
                self:_finishToCooldown()
            end
        end
    elseif s == "PostShot" then
        self._timer = self._timer - dt
        if self._timer <= 0 then
            pcall(function() setthreadidentity(2); LocalFighter:Input("StartShooting"); setthreadidentity(7) end)
            self:_finishToCooldown()
        end
    elseif s == "Cooldown" then
        self._timer = self._timer - dt
        if self._timer <= 0 then self._state = "Idle" end
    else
        if self._held then self:_start() end
    end
end
function Flickbot:OnKeybind(on)
    self._held = on == true
    if self._held then self:_start()
    elseif self._state == "Flicking" then self:_finishToCooldown() end
end
