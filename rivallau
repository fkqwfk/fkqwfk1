    local data={[utf8.char(1)]={[utf8.char(0)]=utility:EncodeCFrame(CFrame.new(origin,aim)),[utf8.char(1)]=utility:EncodeCFrame(CFrame.new(origin,aim)),[utf8.char(2)]=head,[utf8.char(1)]=utility:EncodeCFrame(CFrame.new(origin,aim))}}
