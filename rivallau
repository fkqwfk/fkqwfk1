    local held=setmetatable({},{__mode="k"})
    local function anyS() return CFG.rank_spoof.enable or CFG.elo_spoof.enable or CFG.name_spoof.enable end
    local function lt(l,v) if not l or not l:IsA("TextLabel") then return end
if l.Text~=v then l.Text=v end
if held[l] then return end
held[l]=true
