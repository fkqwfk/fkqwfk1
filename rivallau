do
    local mats={Neon=Enum.Material.Neon,ForceField=Enum.Material.ForceField,Glass=Enum.Material.Glass,Chrome=Enum.Material.Metal,Ice=Enum.Material.Ice,Diamond=Enum.Material.Glass,Hologram=Enum.Material.ForceField,Ghost=Enum.Material.Neon,Obsidian=Enum.Material.Glass,["Gold Foil"]=Enum.Material.Foil,Frostbite=Enum.Material.Glacier,Plasma=Enum.Material.Neon,Molten=Enum.Material.CorrodedMetal,Prism=Enum.Material.Glass}
    local hl,bp={},{}
    local function dh(p) if hl[p] then pcall(function() hl[p]:Destroy() end)
hl[p]=nil end end
    local function rb(p)
        local s=bp[p]
if not s then return end
        for part,pr in pairs(s) do
            if part.Parent then part.Material=pr.material
part.Color=pr.color
part.Reflectance=pr.reflectance
part.Transparency=pr.transparency end
            for tex,tr in pairs(pr.tex or {}) do if tex.Parent then tex.Transparency=tr end end
        end
        bp[p]=nil
    end
    local function cl() for p in pairs(hl) do dh(p) end
for p in pairs(bp) do rb(p) end end
    RunService.Heartbeat:Connect(function()
        if not CFG.chams.enable then if next(hl) or next(bp) then cl() end; return end
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LocalPlayer and same_environment(plr) then
                local ch=plr.Character; local hum=ch and ch:FindFirstChildOfClass("Humanoid")
                if ch and hum and hum.Health>0 and not (CFG.chams.team_check and plr:GetAttribute("TeamID")==LocalPlayer:GetAttribute("TeamID")) then
                    if CFG.chams.mode=="highlight" then
                        rb(plr)
                        if not hl[plr] or not hl[plr].Parent then
                            hl[plr]=Instance.new("Highlight"); hl[plr].DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl[plr].Parent=ch
                        end
                        hl[plr].Adornee=ch; hl[plr].FillColor=CFG.chams.fill_color
                        hl[plr].FillTransparency=CFG.chams.fill_transparency
                        hl[plr].OutlineColor=CFG.chams.outline_color
                        hl[plr].OutlineTransparency=CFG.chams.outline_transparency
                    else
                        dh(plr)
                        local s=bp[plr] or {}; bp[plr]=s
                        local preset=mats[CFG.chams.material] or Enum.Material.Neon
                        for _,part in ipairs(ch:GetDescendants()) do
                            if part:IsA("BasePart") and part.Transparency<1 then
                                if not s[part] then
                                    local tex={}
                                    for _,t in ipairs(part:GetChildren()) do if t:IsA("Decal") or t:IsA("Texture") then tex[t]=t.Transparency end end
                                    s[part]={material=part.Material,color=part.Color,reflectance=part.Reflectance,transparency=part.Transparency,tex=tex}
                                end
                                part.Material=preset; part.Color=CFG.chams.fill_color
                                part.Transparency=CFG.chams.fill_transparency
                                if CFG.chams.strip_textures then for t in pairs(s[part].tex) do if t.Parent then t.Transparency=1 end end end
                            end
                        end
                    end
                else dh(plr); rb(plr) end
            else dh(plr); rb(plr) end
        end
    end)
end

