do
    local saved=setmetatable({},{__mode="k"})
    local mc_tex=setmetatable({},{__mode="k"})
    local faces={"Front","Back","Bottom","Top","Right","Left"}
    local mc_ids={[Enum.Material.Wood]="3258599312",[Enum.Material.WoodPlanks]="8676581022",[Enum.Material.Brick]="8558400252",[Enum.Material.Cobblestone]="5003953441",[Enum.Material.Concrete]="7341687607",[Enum.Material.DiamondPlate]="6849247561",[Enum.Material.Granite]="4722586771",[Enum.Material.Grass]="4722588177",[Enum.Material.Ice]="3823766459",[Enum.Material.Marble]="62967586",[Enum.Material.Metal]="62967586",[Enum.Material.Sand]="152572215"}
    local ml={}
    for _,m in ipairs(Enum.Material:GetEnumItems()) do ml[string.lower(m.Name)]=m end
    local function rm(n) return ml[string.lower(n:gsub("%s+",""))] end
    local function excl(p)
        if CFG.textures.apply_to_viewmodel then return false end
        local n=p
while n and n~=workspace do if n:IsA("Model") and n:FindFirstChildOfClass("Humanoid") then return true end
n=n.Parent end
        local v=workspace:FindFirstChild("ViewModels")
if v and p:IsDescendantOf(v) then return true end
        if p:IsDescendantOf(Camera) then return true end
        return false
    end
    local function cms(p) if mc_tex[p] then for _,t in ipairs(mc_tex[p]) do if t and t.Parent then t:Destroy() end end mc_tex[p]=nil end end
    local function ams(p,id)
        cms(p)
mc_tex[p]={}
        for _,fn in ipairs(faces) do
            local t=Instance.new("Texture")
t.Texture="rbxassetid://"..id
t.Face=Enum.NormalId[fn]
            t.Color3=p.Color
t.Transparency=p.Transparency
t.StudsPerTileU=3
t.StudsPerTileV=3
            t.Parent=p
table.insert(mc_tex[p],t)
        end
    end
    local function apply(p)
        if not p:IsA("BasePart") or excl(p) then return end
        if not saved[p] then saved[p]={Material=p.Material,Color=p.Color} end
        p.Color=CFG.textures.color
        if CFG.textures.material=="Minecraft" then
            local src=saved[p].Material
local id=mc_ids[src] or "5003953441"
ams(p,id)
        else
            cms(p)
local m=rm(CFG.textures.material)
if m then p.Material=m end
        end
    end
    local conn
    getgenv().riv_enable_textures=function()
        for _,p in ipairs(workspace:GetDescendants()) do apply(p) end
        if conn then conn:Disconnect() end
        conn=workspace.DescendantAdded:Connect(function(p) if CFG.textures.enable then task.defer(apply,p) end end)
    end
    getgenv().riv_disable_textures=function()
        if conn then conn:Disconnect()
conn=nil end
        for p,s in pairs(saved) do if p.Parent then pcall(function() p.Material=s.Material; p.Color=s.Color end) end end
        for p in pairs(mc_tex) do cms(p) end
        saved=setmetatable({},{__mode="k"})
    end
end
