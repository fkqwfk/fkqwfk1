do
    local IM = CFG.item_modifiers
    local items_hooked = setmetatable({}, {__mode = "k"})

    _R.Heartbeat:Connect(function()
        if not LocalFighter then return end
        local ch = LocalPlayer.Character; if not ch then return end
        if IM.infinite_double_jumps then
            pcall(function() mechanics_controller._double_jumps_used = {} end)
        end
    end)

    _R.Heartbeat:Connect(function()
        if not LocalFighter then return end
        pcall(function()
            local items = LocalFighter.Items or {}
            for _, it in pairs(items) do
                if not items_hooked[it] then
                    items_hooked[it] = true
                    if IM.automatic_weapon and it.Info and it.Info.Type == "Gun" then
                        pcall(function()
                            if it.InputSpammingEnabled then
                                it.InputSpammingEnabled.StartShooting = 0
                            end
                        end)
                    end
                end
            end
        end)
    end)

    pcall(function()
        local cv = client_viewmodel
        local oldPlayAnim = cv.PlayAnimation
        cv.PlayAnimation = function(self, key, ...)
            local cfg = IM
            local k = tostring(key):lower()
            if cfg.no_shoot_anim and k:find("shoot") then return end
            if cfg.no_reload_anim and k:find("reload") then return end
            if cfg.no_equip_anim and k:find("equip") then return end
            if cfg.no_sprint_anim and k:find("sprint") then return end
            return oldPlayAnim(self, key, ...)
        end
    end)

    pcall(function()
        local oldStartShooting = gun.StartShooting
        gun.StartShooting = function(c, ie, db)
            local cf = c.ClientFighter
            if not cf.IsLocalPlayer then return oldStartShooting(c, ie, db) end
            local item = cf.EquippedItem
            if not item then return oldStartShooting(c, ie, db) end
            local im = CFG.item_modifiers
            if im.no_spread and item.Info and item.Info.Type == "Gun" then
                c.InputSpammingEnabled = c.InputSpammingEnabled or {}
                c.InputSpammingEnabled.StartShooting = 0
            end
            return oldStartShooting(c, ie, db)
        end
    end)

    _R.Heartbeat:Connect(function()
        if not IM.no_motion then return end
        if not LocalFighter then return end
        local it = LocalFighter.EquippedItem
        if not it then return end
        local vm = it.ViewModel
        if not vm then return end
        local tbl = {"_sliding_spring","_sprinting_spring","_landing_spring","_jump_spring",
                     "_tilt_spring","_impulse_position_spring","_recoil_spring","_unrecoil_spring"}
        for _, k in ipairs(tbl) do
            local s = vm[k]
            if s then
                pcall(function() s.Value = typeof(s.Value) == "Vector3" and Vector3.zero or (typeof(s.Value) == "Vector2" and Vector2.zero or 0) end)
                pcall(function() s.Target = s.Value end)
            end
        end
    end)
end

